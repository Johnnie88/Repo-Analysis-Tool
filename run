# ==============================================================================
# Repository Intelligence Runner - easy launcher for the analyzer / TUI / backend
#
# Usage:
#   ./run                        Interactive analyzer (prompts for input)
#   ./run -i ./my-project --mode full
#   ./run tui                    Launch the Textual TUI
#   ./run backend <args...>      Run the TUI backend API helpers
#   ./run help                   Show this help
# ==============================================================================

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="${SCRIPT_DIR}"
cd "${PROJECT_ROOT}"

if [ -x "${PROJECT_ROOT}/venv/bin/python" ]; then
    PYTHON_BIN="${PROJECT_ROOT}/venv/bin/python"
elif [ -x "${PROJECT_ROOT}/venv/Scripts/python.exe" ]; then
    PYTHON_BIN="${PROJECT_ROOT}/venv/Scripts/python.exe"
else
    PYTHON_BIN="python3"
fi

export PYTHONPATH="${PROJECT_ROOT}/src${PYTHONPATH:+:${PYTHONPATH}}"

usage() {
    cat <<'EOF'
Usage:
  ./run [analyzer options...]   Run the CLI analyzer (interactive if no args)
  ./run tui                     Launch the Textual TUI
  ./run backend <args...>       Run the TUI backend API helpers
  ./run help                    Show this help

Examples:
  ./run -i ./my-project --mode full
  ./run -i https://github.com/user/repo.git
  ./run tui
EOF
}

CMD="${1:-}"

case "${CMD}" in
    help)
        usage
        ;;
    tui)
        shift
        exec "${PYTHON_BIN}" -m repo_analysis.tui "$@"
        ;;
    backend)
        shift
        exec "${PYTHON_BIN}" -m repo_analysis.tui_backend "$@"
        ;;
    analyzer)
        shift
        exec "${PYTHON_BIN}" -m repo_analysis.analyzer "$@"
        ;;
    *)
        exec "${PYTHON_BIN}" -m repo_analysis.analyzer "$@"
        ;;
esac
